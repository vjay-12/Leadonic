{
  "name": "leadonic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"tsx watch backend/src/server.ts\" \"vite\"",
    "dev:server": "tsx watch backend/src/server.ts",
    "dev:client": "vite",
    "build": "prisma generate && vite build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "lint": "oxlint",
    "test": "tsx tests/priority.test.ts && tsx tests/business-rules.test.ts",
    "test:e2e": "node tests/e2e-audit.cjs",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-virtual": "^3.14.21",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
