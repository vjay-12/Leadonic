datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LeadStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("#64748B")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  leads     Lead[]
  contactLogs ContactLog[]

  @@map("lead_statuses")
}

model LeadCategory {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  leads     Lead[]
  batches   ImportBatch[]

  @@map("lead_categories")
}

model ImportBatch {
  id           Int           @id @default(autoincrement())
  fileName     String        @map("file_name")
  categoryId   Int?          @map("category_id")
  category     LeadCategory? @relation(fields: [categoryId], references: [id])
  addedCount   Int           @default(0) @map("added_count")
  skippedCount Int           @default(0) @map("skipped_count")
  errorCount   Int           @default(0) @map("error_count")
  createdAt    DateTime      @default(now()) @map("created_at")
  leads        Lead[]

  @@map("import_batches")
}

model Lead {
  id              Int           @id @default(autoincrement())
  title           String
  titleLower      String?       @default(dbgenerated()) @map("title_lower")
  phone           String?
  phoneNormalized String?       @map("phone_normalized")
  dedupeKey       String        @unique @map("dedupe_key")
  emails          String?
  website         String?
  mapsCategory    String?       @map("maps_category")
  address         String?
  reviewRating    Decimal?      @map("review_rating") @db.Decimal(3, 1)
  reviewCount     Int?          @map("review_count")
  hasWebsite      Boolean?      @map("has_website")
  needsWebsite    Boolean?      @map("needs_website")
  erpMatch        String?       @map("erp_match")
  needsErp        Boolean?      @map("needs_erp")
  priorityScore   Decimal?      @map("priority_score") @db.Decimal(8, 2)
  priority        String?
  remarks         String?
  statusId        Int?          @map("status_id")
  status          LeadStatus?   @relation(fields: [statusId], references: [id])
  categoryId      Int?          @map("category_id")
  category        LeadCategory? @relation(fields: [categoryId], references: [id])
  batchId         Int?          @map("batch_id")
  batch           ImportBatch?  @relation(fields: [batchId], references: [id])
  archivedAt      DateTime?     @map("archived_at")
  lastContactDate DateTime?     @map("last_contact_date") @db.Date
  contactLogs     ContactLog[]
  school          School?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([statusId])
  @@index([categoryId])
  @@index([priority])
  @@index([archivedAt])
  @@index([lastContactDate])
  @@index([titleLower])
  @@map("leads")
}

model ContactLog {
  id          Int          @id @default(autoincrement())
  leadId      Int          @map("lead_id")
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactDate DateTime     @map("contact_date") @db.Date
  statusId    Int          @map("status_id")
  status      LeadStatus   @relation(fields: [statusId], references: [id])
  notes       String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([leadId, contactDate])
  @@map("contact_logs")
}

model SchoolStage {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  color     String          @default("#64748B")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  schools   School[]
  meetings  SchoolMeeting[]

  @@map("school_stages")
}

model School {
  id              Int             @id @default(autoincrement())
  name            String
  area            String?
  address         String?
  phone           String?
  email           String?
  website         String?
  studentStrength Int?            @map("student_strength")
  notes           String?         @db.Text
  stageId         Int?            @map("stage_id")
  stage           SchoolStage?    @relation(fields: [stageId], references: [id])
  leadId          Int?            @unique @map("lead_id")
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dedupeKey       String          @unique @map("dedupe_key")
  archivedAt      DateTime?       @map("archived_at")
  contacts        SchoolContact[]
  meetings        SchoolMeeting[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([stageId])
  @@index([area])
  @@index([archivedAt])
  @@map("schools")
}

model SchoolContact {
  id        Int             @id @default(autoincrement())
  schoolId  Int             @map("school_id")
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  notes     String?         @db.Text
  isPrimary Boolean         @default(false) @map("is_primary")
  meetings  SchoolMeeting[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("school_contacts")
}

model SchoolMeeting {
  id           Int            @id @default(autoincrement())
  schoolId     Int            @map("school_id")
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meetingDate  DateTime       @map("meeting_date") @db.Date
  meetingTime  String?        @map("meeting_time")
  type         String
  locationName String?        @map("location_name")
  contactId    Int?           @map("contact_id")
  contact      SchoolContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stageId      Int            @map("stage_id")
  stage        SchoolStage    @relation(fields: [stageId], references: [id])
  notes        String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([schoolId, meetingDate])
  @@index([stageId])
  @@map("school_meetings")
}

